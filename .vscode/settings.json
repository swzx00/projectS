{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode", // 使用 Prettier 格式化
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // 明確為 .vue 文件設置格式化工具
  },
  "editor.formatOnSave": true, // 儲存時自動格式化
  "prettier.requireConfig": true, // 確保 Prettier 使用專案內的設定
  "prettier.enableDebugLogs": true, // 啟用除錯日誌以檢查問題
  "tailwindCSS.experimental.classRegex": ["tw`([^`]*)", "tw\\(([^)]*)\\)"],
  "files.eol": "\n",
  "cSpell.words": [
    "autodocs",
    "composables",
    "DDTHH",
    "defval",
    "dompurify",
    "endregion",
    "Fira",
    "framename",
    "groot",
    "gsap",
    "JhengHei",
    "jschardet",
    "materialdesignicons",
    "nitropack",
    "nosf",
    "Noto",
    "Nuxt",
    "nuxtjs",
    "ofetch",
    "persistedstate",
    "Photoshop",
    "Pinia",
    "postcss",
    "qrcode",
    "rowspan",
    "swiper",
    "swzx",
    "tabpanel",
    "tailwindcss",
    "Treebuy",
    "usetype",
    "VITE",
    "vuedraggable",
    "vuetify",
    "vueuse",
    "youtu"
  ],
  "css.customData": [
    ".vscode/css_custom_data.json"
  ],
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#53dcef",
    "activityBar.activeBorder": "#15202b",
    "activityBar.background": "#53dcef",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#ec33d5",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#53dcef",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#53dcef",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.border": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "sash.hoverBorder": "#53dcef",
    "statusBar.background": "#24d3eb",
    "statusBar.debuggingBackground": "#24d3eb",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.foreground": "#15202b",
    "statusBar.inactiveBackground": "#24d3eb",
    "statusBarItem.hoverBackground": "#12b3ca",
    "statusBarItem.remoteBackground": "#ea15d0",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#24d3eb",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#24d3eb99",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#24d3eb"
}
